{
  pascalsTriangle ← λn.
    { choose ← λn.λk. {Π ← [(*)/ₒ 1 (x..y)]; (Π (n-k+1) n)/.(Π 1 k)}
    ; (⍳ n) [?y>x,.0,.choose x y]⊗ (⍳ n)
    };
  sift ← [(even.§xᶥ)⊂x];
  Δ ← λA. {nr ⟜ 𝓉 A;take# nr'A};
  o ⟜ Δ (sift (pascalsTriangle N));
  (-)`(di. o) (0⊳di. ({: o))
